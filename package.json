{
  "name": "educoder-study-assistant",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "description": "头歌（Educoder）实训题面抽取、代码生成、自动注入与评测闭环",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none \"test/**/*.test.ts\"",
    "icons": "python scripts/make-icons.py"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
